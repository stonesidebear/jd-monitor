# Python
__pycache__/
*.py[cod]

# Virtual Environment
.venv/
venv/

# macOS
.DS_Store

# Scraping data - raw dumps regenerated every run
data/ajax/
data/latest.html
data/screenshots/
data/logs/

# data/ai_price_cache.json and data/mercari_cache.json are intentionally
# NOT ignored: GitHub Actions checks out a fresh environment every run, so
# an ignored cache never survives between runs and gets rebuilt (and
# re-billed, for the AI cache) from scratch every time. They must be
# committed back for "don't call the API twice for the same product" to
# actually hold across runs, not just within a single one.

# Stray leftovers from early development, unused by the app
data/products.csv
data/expected_prices.py

# data/csv/ (latest snapshot) and data/history/ (daily archive) are
# intentionally NOT ignored: they are the persistent state the scraper
# diffs against on the next run (see main.py _apply_diff).